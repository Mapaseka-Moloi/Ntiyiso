# Apache clean-URL support for Ntiyiso.
# Put this in the document root (or inside the relevant <Directory> block).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /app/settings -> /app/settings/index.html
  RewriteRule ^app/settings/?$ app/settings/index.html [L]

  # Directory-style clean URLs: /app/check -> /app/check/index.html
  # Only rewrite when the target index.html actually exists.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

ErrorDocument 404 /404.html
